{
  "name": "sproutworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint src",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "db:migrate": "node --experimental-strip-types scripts/backup-then-migrate.ts",
    "db:generate": "prisma generate",
    "seed:fixtures": "node --experimental-strip-types scripts/seed-fixtures.ts",
    "refresh": "node --experimental-strip-types scripts/refresh.ts",
    "postinstall": "prisma generate",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "restore": "node --experimental-strip-types scripts/restore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fast-xml-parser": "^5.12.0",
    "jszip": "^3.10.2",
    "next": "^16.4.5",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
